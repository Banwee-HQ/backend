# ============================================
# BANWEE BACKEND ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in the appropriate values

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
ENVIRONMENT=local
DOMAIN=localhost

# =============================================================================
# URL CONFIGURATION
# =============================================================================
# Development URLs (for local development)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Production URLs (uncomment for production deployment)
# FRONTEND_URL=https://banwee.com
# BACKEND_URL=https://api.banwee.com
# BACKEND_CORS_ORIGINS=https://banwee.com,https://www.banwee.com

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# For local PostgreSQL:
# POSTGRES_DB_URL=postgresql+asyncpg://banwee:banwee_password@localhost:5432/banwee_db

# For Neon Cloud Database:
# POSTGRES_DB_URL=postgresql+asyncpg://neondb_owner:your_password@your-neon-host.neon.tech/neondb?sslmode=require

POSTGRES_DB_URL=postgresql+asyncpg://user:password@host:port/database
# Deprecated: do not use separate POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB variables.
# Use the single POSTGRES_DB_URL connection string (examples above show local and Neon formats).

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
ENABLE_REDIS=true
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
REDIS_RATELIMIT_ENABLED=true
REDIS_CACHE_TTL=3600
REDIS_CART_TTL_GUEST=1800
REDIS_CART_TTL_USER=259200
REDIS_CART_EXTEND_ON_ADD=true

# =============================================================================
# BACKGROUND TASKS CONFIGURATION (ARQ)
# =============================================================================
ENABLE_ARQ=true
ARQ_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FORCE_LOGOUT_ON_PASSWORD_CHANGE=true

# =============================================================================
# STRIPE PAYMENT CONFIGURATION
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# EMAIL CONFIGURATION (Brevo)
# =============================================================================
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=Banwee <noreply@banwee.com>

# =============================================================================
# SOCIAL AUTHENTICATION (Google + Facebook)
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
ADMIN_USER_ID=your_admin_uuid_here

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_CLEANUP_INTERVAL_SECONDS=86400
