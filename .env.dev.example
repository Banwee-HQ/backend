# ============================================================
# Banwee Backend — Development Environment
# Copy this file to .env.dev and fill in your values.
# Never commit `.env.dev` to version control. Keep real secrets out
# of the repository and use CI / secret stores for production.
# ============================================================

# -------------------------
# Application
# -------------------------
# `ENVIRONMENT` controls environment-specific behavior; keep `dev` locally.
ENVIRONMENT=dev
# Public host/domain used in some URL generation. Use `localhost` for dev.
DOMAIN=localhost
# Where the backend API runs (used by local frontend & tests).
BACKEND_URL=http://localhost:8000
# Frontend URL used for redirects/origins in dev.
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed for CORS in development.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -------------------------
# Database - PostgreSQL Only
# -------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Connection pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# -------------------------
# Security
# -------------------------
# `SECRET_KEY` must be a long random string. Generate with:
# `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=your_dev_secret_key_min_32_chars
ALGORITHM=HS256
# Token lifespan settings (minutes/days).
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
FORCE_LOGOUT_ON_PASSWORD_CHANGE=true

# -------------------------
# Payment (Stripe)
# -------------------------
# Use test keys in development (begin with `sk_test_` / `pk_test_`).
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -------------------------
# Email — Brevo (SendinBlue)
# -------------------------
# API key for transactional emails. Keep this secret in dev/CI.
BREVO_API_KEY=your_brevo_api_key
# Sender address used for transactional emails.
BREVO_FROM_EMAIL=Banwee <noreply@banwee.com>

# -------------------------
# OAuth Providers
# -------------------------
# Google OAuth credentials for social sign-in in dev.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth credentials for social sign-in in dev.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# -------------------------
# Admin
# -------------------------
# Optional: UUID of a local admin user used for quick access in dev.
ADMIN_USER_ID=your_admin_uuid_here

# -------------------------
# Background Jobs
# -------------------------
# Settings that control background job behavior in development.
NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_CLEANUP_INTERVAL_SECONDS=86400
