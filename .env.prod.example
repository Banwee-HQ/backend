# ============================================================
# Banwee Backend — Production Environment (example)
# Copy this file to .env.prod in your production server/CI and fill
# with real values from your secret manager. Do NOT commit secrets.
# ============================================================

# -------------------------
# Application
# -------------------------
# Set to 'prod' in production deployments.
ENVIRONMENT=prod
# Public domain for the application (used to build absolute URLs).
DOMAIN=example.com
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
# Comma-separated CORS origins for the production frontend(s).
BACKEND_CORS_ORIGINS=https://www.example.com

# -------------------------
# Database - PostgreSQL Only
# -------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# -------------------------
# Security
# -------------------------
# Use a long, secure `SECRET_KEY` from a secrets manager.
SECRET_KEY=replace_with_strong_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
FORCE_LOGOUT_ON_PASSWORD_CHANGE=true

# -------------------------
# Payment (Stripe)
# -------------------------
# Use live Stripe keys in production (begin with `sk_live_`).
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -------------------------
# Email — Brevo (SendinBlue)
# -------------------------
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=Banwee <noreply@example.com>

# -------------------------
# OAuth Providers
# -------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# -------------------------
# Admin
# -------------------------
ADMIN_USER_ID=your_admin_uuid_here

# -------------------------
# Background Jobs
# -------------------------
NOTIFICATION_CLEANUP_DAYS=90
NOTIFICATION_CLEANUP_INTERVAL_SECONDS=86400
